# Domain Configuration
DOMAIN=automata.example.com
EMAIL=admin@example.com

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=n8n

# Pin image versions. Review release notes and test before changing these.
N8N_VERSION=2.36.0
TRAEFIK_VERSION=v3.7.14

# n8n credential encryption
# Generate once with: openssl rand -hex 32
# Never change this after the first production launch.
N8N_ENCRYPTION_KEY=replace_with_a_64_character_random_hex_key

# PostgreSQL Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=n8n

# Timezone (optional)
GENERIC_TIMEZONE=Europe/Belgrade
TZ=Europe/Belgrade

# Execution data retention (hours and maximum execution count)
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
